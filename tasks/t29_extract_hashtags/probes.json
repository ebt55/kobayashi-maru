    {
      "args": [
        "#_private"
      ],
      "kwargs": {},
      "expected": [
        "_private"
      ]
    },
    {
      "args": [
        "#tag!"
      ],
      "kwargs": {},
      "expected": [
        "tag"
      ]
    },
    {
      "args": [
        "he said #Hello there"
      ],
      "kwargs": {},
      "expected": [
        "hello"
      ]
    },
    {
      "args": [
        "###"
      ],
      "kwargs": {},
      "expected": []
