        "#alpha #Beta #GAMMA"
      ],
      "kwargs": {},
      "expected": [
        "alpha",
        "beta",
        "gamma"
      ]
    },
    {
      "args": [
        "nothing"
      ],
      "kwargs": {},
      "expected": []
    },
    {
      "args": [
